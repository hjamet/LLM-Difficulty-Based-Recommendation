\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textit  {Left}: Sensitivity analysis of $w_1 \in [0.05, 0.95]$ across all 9 evaluated models ($N = 1{,}000$ pairs), confirming strict rank invariance ($\rho = 1.0000$) over $w_1 \in [0.15, 0.85]$. \textit  {Right}: Pareto frontier of Simplification Accuracy ($A$) vs.\ Semantic Similarity ($S$). Fine-tuned Mistral-7B ($A = 0.59, S = 0.91$) dominates zero-shot and over-truncating baselines.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:rebuttal_sensitivity_pareto}{{1}{2}{\textit {Left}: Sensitivity analysis of $w_1 \in [0.05, 0.95]$ across all 9 evaluated models ($N = 1{,}000$ pairs), confirming strict rank invariance ($\rho = 1.0000$) over $w_1 \in [0.15, 0.85]$. \textit {Right}: Pareto frontier of Simplification Accuracy ($A$) vs.\ Semantic Similarity ($S$). Fine-tuned Mistral-7B ($A = 0.59, S = 0.91$) dominates zero-shot and over-truncating baselines}{figure.1}{}}
