\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Complete statistical evaluation of text difficulty estimation across all three French datasets (revised Table 2). Values for GPT-4o and GPT-4o-mini report mean $\pm $ bootstrap standard error ($\sigma $, $B = 1{,}000$ resamples). Acc.: multiclass accuracy; F1: Macro-F1; MAE: Mean Absolute Error in CEFR steps; QWK: Quadratic Weighted Kappa; $PM_{\text  {norm}}$: normalized Pairwise Mismatch rate (\%). Wilcoxon signed-rank test markers compare prompted against unprompted variants ($^{**}p < 0.01$, $^{***}p < 0.001$, $\text  {ns}$: $p \ge 0.05$).}}{2}{table.1}\protected@file@percent }
\newlabel{tab:rebuttal_table2}{{1}{2}{Complete statistical evaluation of text difficulty estimation across all three French datasets (revised Table 2). Values for GPT-4o and GPT-4o-mini report mean $\pm $ bootstrap standard error ($\sigma $, $B = 1{,}000$ resamples). Acc.: multiclass accuracy; F1: Macro-F1; MAE: Mean Absolute Error in CEFR steps; QWK: Quadratic Weighted Kappa; $PM_{\text {norm}}$: normalized Pairwise Mismatch rate (\%). Wilcoxon signed-rank test markers compare prompted against unprompted variants ($^{**}p < 0.01$, $^{***}p < 0.001$, $\text {ns}$: $p \ge 0.05$)}{table.1}{}}
