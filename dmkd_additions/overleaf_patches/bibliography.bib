  author    = {Tak\'{a}cs, G\'{a}bor and Pil\'{a}szy, Istv\'{a}n and Tikk, Domonkos},
  year      = 2011,
  booktitle = {Proceedings of the Fifth ACM Conference on Recommender Systems},
